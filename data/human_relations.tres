[resource]
script = ExtResource("2_isnpa")
id = "human_relations"
name = "Relations humaines"
description = "Portée notamment par Elton Mayo, l'école des relations humaines place la personne au cœur de l'entreprise.

Cette école s'intéresse au facteur humain dans l'entreprise. Elle montre que la productivité ne dépend pas seulement des conditions matérielles, mais aussi de la reconnaissance, de l'ambiance de travail et du sentiment d'appartenance à un groupe.

Vos managers sont attentifs à leurs employés : le moral de vos équipes, et leur productivité s'améliorent."
requierment = Array[ExtResource("2_isnpa")]([ExtResource("4_1yx7e")])
effects = Array[ExtResource("1_3r22u")]([SubResource("Resource_1yx7e"), SubResource("Resource_otikt")])
conditions = SubResource("Resource_nq0pk")
metadata/_custom_type_script = "uid://jfrest3lsltq"

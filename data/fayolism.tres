[resource]
script = ExtResource("2_qk3yr")
id = "fayolism"
name = "Fayolisme"
description = "Le fayolisme est une théorie de l'administration des entreprises. Henri Fayol y divise l'activité de toute entreprise en six fonctions : techniques, commerciales, financières, de sécurité, comptables et administratives. Il résume le rôle du dirigeant en cinq verbes : prévoir, organiser, commander, coordonner et contrôler.

Votre direction gagne en méthode : les responsabilités sont clairement réparties et l'entreprise est mieux pilotée, même si elle laisse peu de place à l'initiative."
requierment = Array[ExtResource("2_qk3yr")]([ExtResource("3_en13e")])
effects = Array[ExtResource("1_wbnjf")]([SubResource("Resource_14dii")])
conditions = SubResource("Resource_x8tvb")
metadata/_custom_type_script = "uid://jfrest3lsltq"

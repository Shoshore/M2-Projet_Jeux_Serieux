[resource]
script = ExtResource("2_qk3yr")
id = "fayolism"
name = "Fayolisme"
description = "Henri Fayol divise l'activité de toute entreprise industrielle ou commerciale en six catégories essentielles :
- Techniques (production, fabrication, transformation)
- Commerciales (achats, ventes, échanges)
- Financières (recherche et gestion optimale des capitaux)
- De sécurité (protection des biens et des personnes)
- Comptables (inventaires, bilans, calcul des prix de revient)
- Administratives (prévoir, organiser, commander, coordonner, contrôler)"
requierment = Array[ExtResource("2_qk3yr")]([ExtResource("3_en13e")])
metadata/_custom_type_script = "uid://jfrest3lsltq"

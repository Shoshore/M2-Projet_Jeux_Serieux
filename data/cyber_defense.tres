[resource]
script = ExtResource("2_2yh0k")
id = "cyber_defense"
name = "Défense"
description = "Dans la cybersécurité, l'attaquant n'a besoin de trouver qu'une seule {0} ; le défenseur, lui, doit toutes les combler.

La cyberdéfense regroupe l'ensemble des moyens mis en place pour {1}, bloquer et répondre aux cyberattaques. Pare-feu, antivirus, détection d'intrusion, {2} et plans de reprise d'activité forment autant de lignes de défense successives.

Votre entreprise résiste mieux aux attaques de ses concurrents, et se remet plus vite lorsqu'elle est touchée."
requierment = Array[ExtResource("2_2yh0k")]([ExtResource("3_2yh0k")])
effects = Array[ExtResource("1_ul5v0")]([SubResource("Resource_a7dnq"), SubResource("Resource_uqn18")])
conditions = SubResource("Resource_ww3np")
blanks = Array[ExtResource("1_22dwp")]([SubResource("Blank_cyber_defense_0"), SubResource("Blank_cyber_defense_1"), SubResource("Blank_cyber_defense_2")])

[resource]
script = ExtResource("2_2yh0k")
id = "cyber_defense"
name = "Défense"
description = "Dans la cybersécurité, l'attaquant n'a pas besoin de trouver qu'une seule faille ; le défenseur, lui, doit toutes les combler.

La cyberdéfense regroupe l'ensemble des moyens mis en place pour détecter, bloquer et répondre aux cyberattaques. Pare-feu, antivirus, détection d'intrusion, sauvegardes et plans de reprise d'activité forment autant de lignes de défense successives.

Votre entreprise résiste mieux aux attaques de ses concurrents, et se remet plus vite lorsqu'elle est touchée."
requierment = Array[ExtResource("2_2yh0k")]([ExtResource("3_2yh0k")])
effects = Array[ExtResource("1_ul5v0")]([SubResource("Resource_a7dnq")])
conditions = SubResource("Resource_ww3np")

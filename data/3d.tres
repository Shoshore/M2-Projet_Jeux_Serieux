[resource]
script = ExtResource("2_h3qln")
id = "3d"
name = "3D"
description = "L'infographie 3D consiste à représenter des objets en trois dimensions, généralement sous forme de maillages de polygones. Ces objets sont éclairés, texturés et animés, puis le rendu calcule l'image finale vue par une caméra virtuelle, en simulant le trajet de la lumière.

Votre entreprise peut désormais proposer des jeux vidéo, des simulations et des visualisations 3D : des projets plus ambitieux, et mieux payés."
requierment = Array[ExtResource("2_h3qln")]([ExtResource("3_h3qln")])
effects = Array[ExtResource("1_yn8uq")]([SubResource("Resource_14dii")])
conditions = SubResource("Resource_fog4q")
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_kg5qp")
id = "post_fordism"
name = "Post-Fordisme"
description = "Le post-fordisme désigne le modèle d'organisation qui succède au {0} à partir des années 1970. Il privilégie la {1} : production en petites séries, produits {2}, nouvelles technologies de l'information et attention portée aux différents types de {3}.

Votre entreprise s'adapte rapidement aux demandes de chaque client, au lieu de produire la même chose pour tout le monde.

Le travail est moins répétitif, et vos employés plus impliqués."
requierment = Array[ExtResource("2_kg5qp")]([ExtResource("3_kg5qp")])
effects = Array[ExtResource("1_6w0i2")]([SubResource("Resource_14dii"), SubResource("Resource_4aiyl")])
conditions = SubResource("Resource_16ip4")
blanks = Array[ExtResource("1_ad65g")]([SubResource("Blank_post_fordism_0"), SubResource("Blank_post_fordism_1"), SubResource("Blank_post_fordism_2"), SubResource("Blank_post_fordism_3")])
metadata/_custom_type_script = "uid://jfrest3lsltq"

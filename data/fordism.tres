[resource]
script = ExtResource("2_h5irr")
id = "fordism"
name = "Fordisme"
description = "Le fordisme reprend les principes du taylorisme et y ajoute le travail à la chaîne et la standardisation : on produit en grande série des produits identiques, à partir de pièces interchangeables. Les salaires sont augmentés, pour stimuler la consommation et pour limiter les départs d'ouvriers.

Henry Ford le résumait lui-même : des ouvriers mieux payés sont « exempts de préoccupation étrangère au travail, et donc plus industrieux ».

Votre entreprise produit plus et moins cher, et de meilleurs salaires limitent les départs de vos employés."
requierment = Array[ExtResource("2_h5irr")]([ExtResource("3_h5irr")])
effects = Array[ExtResource("1_4ospx")]([SubResource("Resource_14dii"), SubResource("Resource_4aiyl")])
conditions = SubResource("Resource_ysboq")
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_h5irr")
id = "fordism"
name = "Fordisme"
description = "Le fordisme reprend les principes du {0} et y ajoute le travail à la {1} et la {2} : on produit en grande série des produits identiques, à partir de pièces interchangeables. Les salaires sont {3}, pour stimuler la consommation et pour limiter les départs d'ouvriers.

Henry {4} le résumait lui-même : des ouvriers mieux payés sont « exempts de préoccupation étrangère au travail, et donc plus industrieux ».

Votre entreprise produit plus et moins cher, et de meilleurs salaires limitent les départs de vos employés."
requierment = Array[ExtResource("2_h5irr")]([ExtResource("3_h5irr")])
effects = Array[ExtResource("1_4ospx")]([SubResource("Resource_14dii"), SubResource("Resource_4aiyl")])
conditions = SubResource("Resource_ysboq")
blanks = Array[ExtResource("1_vc0n0")]([SubResource("Blank_fordism_0"), SubResource("Blank_fordism_1"), SubResource("Blank_fordism_2"), SubResource("Blank_fordism_3"), SubResource("Blank_fordism_4")])
metadata/_custom_type_script = "uid://jfrest3lsltq"

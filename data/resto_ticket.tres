[resource]
script = ExtResource("2_w3yis")
id = "resto_ticket"
name = "Ticket restaurant"
description = "Le titre-restaurant est un avantage {0} qui permet aux salariés de payer leur repas pendant leur journée de travail. Il est remis par l'{1} pour chaque jour travaillé, et son montant est financé à la fois par l'employeur et par le {2}.

Vos employés apprécient ce petit avantage, et cela se voit sur leur humeur."
requierment = Array[ExtResource("2_w3yis")]([ExtResource("3_w3yis")])
effects = Array[ExtResource("1_wqb6y")]([SubResource("Resource_5vg6x"), SubResource("Resource_ddk4k")])
conditions = SubResource("Resource_8g1ol")
blanks = Array[ExtResource("1_pjlcb")]([SubResource("Blank_resto_ticket_0"), SubResource("Blank_resto_ticket_1"), SubResource("Blank_resto_ticket_2")])

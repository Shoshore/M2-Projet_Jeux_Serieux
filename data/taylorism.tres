[resource]
script = ExtResource("2_cgvwa")
id = "taylorism"
name = "Taylorisme"
description = "Le taylorisme, ou organisation {0} du travail, consiste à analyser en détail les gestes et les {1} de production pour définir la « meilleure façon » d'accomplir chaque tâche. Le travail est découpé en tâches simples et répétitives, et la rémunération est liée au {2}.

La productivité de vos employés augmente nettement, mais un travail aussi répétitif pèse sur leur moral, vos employés ont de plus en plus l'impression d'être des {3}."
requierment = Array[ExtResource("2_cgvwa")]([ExtResource("4_602vq")])
effects = Array[ExtResource("1_eb4ik")]([SubResource("Resource_qk3yr"), SubResource("Resource_602vq")])
conditions = SubResource("Resource_1t56v")

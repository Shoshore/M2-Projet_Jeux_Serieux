[resource]
script = ExtResource("2_63wr5")
id = "stuff_3"
name = "Amélioration mobilier 3"
description = "Les études sur les bureaux en open space relèvent souvent un niveau élevé de bruit et de stress. Pour y répondre, de nombreuses entreprises adoptent l'aménagement par activités : cabines téléphoniques, salles de concentration, espaces collaboratifs. Chacun choisit l'espace adapté à sa tâche du moment.

Vos employés travaillent dans de meilleures conditions, et votre entreprise attire davantage de talents."
requierment = Array[ExtResource("2_63wr5")]([ExtResource("3_63wr5")])
effects = Array[ExtResource("1_oxwe4")]([SubResource("Resource_libgm")])
conditions = SubResource("Resource_14dii")
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_ffrip")
id = "langages_prog"
name = "Langages de programmation"
description = "Un langage de programmation est construit à partir d'une grammaire formelle, qui inclut des symboles et des règles syntaxiques, auxquels sont associées des règles sémantiques. 

Ces éléments sont plus ou moins complexes selon la capacité du langage.

Ce sont ces éléments qui permettent de communiquer clairement avec la machine."

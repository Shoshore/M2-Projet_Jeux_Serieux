[resource]
script = ExtResource("2_ffrip")
id = "langages_prog"
name = "Langages de programmation"
description = "Un langage de programmation est une notation formelle qui permet d'écrire des instructions compréhensibles à la fois par l'humain et par la machine. Il repose sur une syntaxe, qui fixe la forme du code, et sur une sémantique, qui en fixe le sens. 

Un compilateur ou un interpréteur traduit ensuite ce code en instructions exécutables par le processeur.

Maîtriser plusieurs langages permettra à vos employés de choisir le bon outil pour chaque projet, et donc de livrer plus vite et plus souvent, ce qui augmentera la confiance des clients envers votre entreprise."
requierment = Array[ExtResource("2_ffrip")]([ExtResource("3_ffrip")])
effects = Array[ExtResource("1_b21a1")]([SubResource("Resource_8r1cr")])
conditions = SubResource("Resource_it2oe")
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_gh337")
id = "stuff_2"
name = "Amélioration mobilier 2"
description = "Selon l'Organisation mondiale de la santé, la sédentarité, comme le temps passé en position assise, a de nombreux effets négatifs sur la santé. Les bureaux assis-debout permettent de rompre les longues périodes passées assis devant l'écran.

Vos employés bougent davantage et terminent leur journée moins fatigués."
requierment = Array[ExtResource("2_gh337")]([ExtResource("3_gh337")])
effects = Array[ExtResource("1_pq88x")]([SubResource("Resource_woeao")])
conditions = SubResource("Resource_4aiyl")
metadata/_custom_type_script = "uid://jfrest3lsltq"

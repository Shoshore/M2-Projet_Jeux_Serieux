[resource]
script = ExtResource("2_3isgg")
id = "cyber_attack"
name = "Attaque"
description = "Une cyberattaque peut émaner d'un pirate isolé, d'un groupe organisé, ou même d'un État.

Une cyberattaque est un acte offensif visant un système informatique à travers un réseau. Elle peut chercher à voler des données, à les chiffrer pour exiger une rançon (rançongiciel), à saturer un service pour le rendre inaccessible (déni de service) ou à piéger un utilisateur pour obtenir ses identifiants (hameçonnage).

Votre entreprise apprend à exploiter les failles de ses concurrents : vos attaques deviennent plus efficaces."
requierment = Array[ExtResource("2_3isgg")]([ExtResource("3_3isgg")])
effects = Array[ExtResource("1_ejmq2")]([SubResource("Resource_wofmb")])
conditions = SubResource("Resource_iild1")
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_3isgg")
id = "cyber_attack"
name = "Attaque"
description = "Une cyberattaque peut émaner d'un pirate isolé, d'un groupe organisé, ou même d'un État.

Une cyberattaque est un acte 
{0} visant un système informatique à travers un réseau. Elle peut chercher à voler des données, à les {1} pour exiger une rançon (rançongiciel), à saturer un service pour le rendre inaccessible (déni de service) ou à piéger un utilisateur pour obtenir ses identifiants ({2}).

Votre entreprise apprend à exploiter les failles de ses concurrents : vos attaques deviennent plus efficaces."
requierment = Array[ExtResource("2_3isgg")]([ExtResource("3_3isgg")])
effects = Array[ExtResource("1_ejmq2")]([SubResource("Resource_wofmb"), SubResource("Resource_bfdkv")])
conditions = SubResource("Resource_iild1")
blanks = Array[ExtResource("1_3fgag")]([SubResource("Blank_cyber_attack_0"), SubResource("Blank_cyber_attack_1"), SubResource("Blank_cyber_attack_2")])
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_56ouo")
id = "data_science"
name = "Data Science"
description = "La science des données est un domaine interdisciplinaire qui utilise les statistiques, le calcul scientifique, les méthodes scientifiques, les algorithmes et les systèmes informatiques automatisés pour extraire et extrapoler des connaissances à partir de grandes quantités de données brutes, structurées ou non.

Étudier ces données permet de prendre de meilleures décisions.

On comprend donc mieux ses clients et on repère mieux les tendances."

[resource]
script = ExtResource("2_wl1ri")
id = "ia"
name = "IA"
description = "L'intelligence artificielle regroupe les techniques qui permettent à une machine d'imiter certaines capacités humaines : reconnaître des images, comprendre le langage, prendre des décisions. Les approches modernes reposent sur l'apprentissage automatique : le programme apprend à partir d'exemples plutôt qu'à partir de règles écrites à la main.

Cette technologie offre un gain de productivité énorme à votre entreprise. Mais vos employés craignent d'être remplacés, et leur moral en pâtit."
requierment = Array[ExtResource("2_wl1ri")]([ExtResource("3_myx1x"), ExtResource("4_2b6wj"), ExtResource("5_xf5f8"), ExtResource("6_b28c2"), ExtResource("7_0j5i7"), ExtResource("9_xf5f8")])

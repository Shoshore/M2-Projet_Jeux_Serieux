[resource]
script = ExtResource("2_ss6r0")
id = "info_graphics"
name = "Informatique graphique"
description = "L'informatique graphique est le domaine de l'informatique qui étudie la création, la manipulation et 
l'{0} d'images par ordinateur. Elle combine des principes de physique, de géométrie et de calcul numérique pour produire des images à la fois {1} et rapides à calculer. Elle joue un rôle fondamental dans le cinéma, les jeux vidéo et les environnements {2}.

Vos logiciels gagnent en lisibilité et en attrait : les clients les adoptent plus volontiers.

Deux voies s'ouvrent à vous : la 2D et la 3D."
requierment = Array[ExtResource("2_ss6r0")]([ExtResource("3_ss6r0")])
effects = Array[ExtResource("1_y10ri")]([SubResource("Resource_14dii"), SubResource("Resource_bfdkv")])
conditions = SubResource("Resource_an2ig")
blanks = Array[ExtResource("1_tw3d8")]([SubResource("Blank_info_graphics_0"), SubResource("Blank_info_graphics_1"), SubResource("Blank_info_graphics_2")])

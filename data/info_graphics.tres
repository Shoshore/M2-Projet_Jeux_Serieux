[resource]
script = ExtResource("2_ss6r0")
id = "info_graphics"
name = "Informatique graphique"
description = "L’informatique graphique est un domaine en constante évolution de l’informatique, axé sur la modélisation mathématique et la simulation du monde tridimensionnel. Elle combine des principes de physique, de géométrie et de calcul numérique pour atteindre à la fois un réalisme physique et une efficacité computationnelle. Depuis longtemps, l’informatique graphique joue un rôle fondamental dans la création de contenus visuels pour le cinéma, les jeux vidéo et les environnements virtuels."
requierment = Array[ExtResource("2_ss6r0")]([ExtResource("3_ss6r0")])
metadata/_custom_type_script = "uid://jfrest3lsltq"

[resource]
script = ExtResource("2_rujd6")
id = "paradigme"
name = "Paradigme"
description = "Un paradigme de programmation est une manière de penser et de structurer un programme.

Il existe plusieurs paradigmes de programmation : {0}, fonctionnel, agent ; ils permettent à vos équipes de choisir la meilleure approche pour chaque problème et d'écrire un code plus facile à {1}.

Un code mieux organisé, ce sont moins de bugs et des projets livrés plus tôt.

Vos développeurs ne se contentent plus d'écrire du code : ils savent l'organiser pour qu'il reste clair, 
{2} et facile à faire évoluer."
requierment = Array[ExtResource("2_rujd6")]([ExtResource("4_ae50q")])
effects = Array[ExtResource("1_7h0ta")]([SubResource("Resource_qk3yr")])
conditions = SubResource("Resource_ap0s8")
blanks = Array[ExtResource("1_ae50q")]([SubResource("Blank_paradigme_0"), SubResource("Blank_paradigme_1"), SubResource("Blank_paradigme_2")])

[resource]
script = ExtResource("2_q102j")
id = "agile"
name = "Méthode AGILE"
description = "Les méthodes agiles sont des approches de gestion de projet qui découpent le travail en courtes itérations, à la fin desquelles une version utilisable du produit est livrée. Elles mettent en avant la collaboration au sein d'équipes auto-organisées, l'échange régulier avec le client et l'adaptation au changement.

Vos projets avancent par petites étapes : les erreurs sont repérées plus tôt et les clients sont plus satisfaits.

Les projets sont plus fluides, et les employés plus impliqués."
icone = ExtResource("2_pooy8")
requierment = Array[ExtResource("2_q102j")]([ExtResource("5_a3awv")])
effects = Array[ExtResource("1_strr3")]([SubResource("Resource_a3awv"), SubResource("Resource_0dvx7")])
conditions = SubResource("Resource_6lvo8")
metadata/_custom_type_script = "uid://jfrest3lsltq"

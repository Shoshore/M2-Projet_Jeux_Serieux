[resource]
script = ExtResource("2_q102j")
id = "agile"
name = "Méthode AGILE"
description = "Les méthodes agiles sont des approches de gestion de projet qui découpent le travail en courtes {0}, à la fin desquelles une version utilisable du produit est livrée. Elles mettent en avant la collaboration au sein d'équipes {1}, l'échange régulier avec le {2} et l'adaptation au {3}.

Vos projets avancent par petites étapes : les erreurs sont repérées plus tôt et les clients sont plus satisfaits.

Les projets sont plus fluides, et les employés plus impliqués."
icone = ExtResource("2_pooy8")
requierment = Array[ExtResource("2_q102j")]([ExtResource("5_a3awv")])
effects = Array[ExtResource("1_strr3")]([SubResource("Resource_a3awv"), SubResource("Resource_0dvx7")])
conditions = SubResource("Resource_6lvo8")
blanks = Array[ExtResource("1_0dvx7")]([SubResource("Blank_agile_0"), SubResource("Blank_agile_1"), SubResource("Blank_agile_2"), SubResource("Blank_agile_3")])
metadata/_custom_type_script = "uid://jfrest3lsltq"

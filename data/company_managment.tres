[resource]
script = ExtResource("2_1ggs5")
id = "compagny_managment"
name = "Gestion de l'entreprise"
description = "La gestion d'entreprise, ou management, est l'ensemble des techniques qui permettent d'organiser, de diriger et de contrôler une organisation pour atteindre ses objectifs. Elle touche aussi bien la répartition du travail que les relations entre les personnes.

Votre entreprise commence à se structurer : chacun sait ce qu'il a à faire et à qui il rend des comptes."
requierment = Array[ExtResource("2_1ggs5")]([ExtResource("3_1ggs5")])

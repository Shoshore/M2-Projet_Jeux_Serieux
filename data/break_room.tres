[resource]
script = ExtResource("2_gib2i")
id = "break_room"
name = "Salle de repos"
description = "Une salle de repos est un espace où les employés peuvent faire une pause loin de leur poste : se détendre, discuter, ou même faire une courte sieste. Des pauses régulières limitent la fatigue et aident à rester concentré sur la durée.

Vos employés reviennent de leur pause plus reposés et plus efficaces.

ZZZZZZZZZZzzzzzzzzzzzz....."

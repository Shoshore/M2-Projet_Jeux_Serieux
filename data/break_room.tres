[resource]
script = ExtResource("2_gib2i")
id = "break_room"
name = "Salle de repos"
description = "Une salle de repos est un espace où les employés peuvent faire une pause loin de leur {0} : se détendre, discuter, ou même faire une courte {1}. Des pauses régulières limitent la {2} et aident à rester {3} sur la durée.

Vos employés reviennent de leur pause plus reposés et plus efficaces.

ZZZZZZZZZZzzzzzzzzzzzz....."
requierment = Array[ExtResource("2_gib2i")]([ExtResource("3_gib2i")])
effects = Array[ExtResource("1_52gxm")]([SubResource("Resource_5vg6x"), SubResource("Resource_qk3yr")])
conditions = SubResource("Resource_fwmip")
blanks = Array[ExtResource("1_mkour")]([SubResource("Blank_break_room_0"), SubResource("Blank_break_room_1"), SubResource("Blank_break_room_2"), SubResource("Blank_break_room_3")])

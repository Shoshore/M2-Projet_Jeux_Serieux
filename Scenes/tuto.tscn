[node name="goal" type="RichTextLabel" parent="PanelContainer/VBoxContainer" unique_id=1036708432]
layout_mode = 2
bbcode_enabled = true
text = "[center][u]Objectif du jeu :[/u][/center]
[table=1]
[cell]- Votre objectif est de maximiser votre score (argent) pendant le nombre de tours imparti.[/cell]
[cell]- Si vous avez une somme négative d'argent, vous aurez 2 tours pour repasser en positif, sinon vous aurez perdu.[/cell]
[cell]- Vous pouvez emprunter de l'argent, avec un temps de recharge de 5 tours, mais vous devrez rembourser avec des intérêts.[/cell]
[cell]- Les développeurs sont la ressource qui génère du profit à votre entreprise.[/cell]
[cell]- Vous aurez un arbre de compétences à développer ; pour ce faire, les ressources nécessaires seront : les chercheurs et de l'argent.[/cell]
[cell]- Le bonheur de vos employés n'est pas à négliger, sinon ils travailleront moins bien.[/cell]
[/table]"
fit_content = true
scroll_active = false

